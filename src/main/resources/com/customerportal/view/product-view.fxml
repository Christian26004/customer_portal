<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.customerportal.control.ProductController">
    <top>
        <VBox spacing="12.0">
            <padding>
                <Insets top="20.0" right="25.0" bottom="15.0" left="25.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="15.0">
                <Button text="Profile" onAction="#handleProfile" />
                <Label text="Products" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="cartSummaryLabel" text="Cart: 0 items | Subtotal: $0.00" />
                <Button text="Proceed to Checkout" onAction="#handleProceedToCheckout" />
            </HBox>
            <HBox spacing="10.0">
                <TextField fx:id="searchField" promptText="Search products..." HBox.hgrow="ALWAYS" />
                <ComboBox fx:id="filterBox" prefWidth="190.0" />
            </HBox>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="true">
            <content>
                <FlowPane fx:id="productGrid" alignment="TOP_CENTER" hgap="16.0" vgap="16.0">
                    <padding>
                        <Insets top="10.0" right="25.0" bottom="25.0" left="25.0" />
                    </padding>
                </FlowPane>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <Label fx:id="messageLabel" wrapText="true">
            <BorderPane.margin>
                <Insets top="8.0" right="25.0" bottom="12.0" left="25.0" />
            </BorderPane.margin>
        </Label>
    </bottom>
</BorderPane>
