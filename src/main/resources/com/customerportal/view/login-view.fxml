<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" spacing="15.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="com.customerportal.control.LoginController">

    <padding>
        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
    </padding>

    <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Customer Login" />

    <TextField fx:id="emailField" maxWidth="300.0" promptText="Email" />

    <PasswordField fx:id="passwordField" maxWidth="300.0" promptText="Password" />

    <Label fx:id="messageLabel" wrapText="true" />

    <Button maxWidth="300.0" onAction="#handleLogin" text="Log In" />

    <Button maxWidth="300.0" onAction="#handleCreateAccount" text="Create Account" />

</VBox>
