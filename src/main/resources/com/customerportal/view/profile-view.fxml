<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="14.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.customerportal.control.ProfileController">

    <padding>
        <Insets top="30.0"
                right="40.0"
                bottom="30.0"
                left="40.0"/>
    </padding>

    <Label text="Customer Profile"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label fx:id="nameLabel"
           text="Name:"/>

    <Label fx:id="emailLabel"
           text="Email:"/>

    <Label text="Address"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Label fx:id="streetLabel"
           text="Street:"/>

    <Label fx:id="cityStateZipLabel"
           text="City, State ZIP"/>

    <Label fx:id="messageLabel"
           wrapText="true"
           maxWidth="300.0"/>

    <Button text="Edit Profile"
            onAction="#handleEditProfile"
            maxWidth="300.0"/>

   <Button text="Shop Products"
            onAction="#handleOpenCart"
            maxWidth="300.0"/>

    <Button text="Order History"
            onAction="#handleOrderHistory"
            maxWidth="300.0"/>

    <Button text="Log Out"
            onAction="#handleLogout"
            maxWidth="300.0"/>



</VBox>