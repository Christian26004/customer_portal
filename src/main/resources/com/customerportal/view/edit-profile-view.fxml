<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="12.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.customerportal.control.EditProfileController">

    <padding>
        <Insets top="25.0"
                right="40.0"
                bottom="25.0"
                left="40.0"/>
    </padding>

    <Label text="Edit Customer Profile"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <TextField fx:id="nameField"
               promptText="Full Name"
               maxWidth="320.0"/>

    <TextField fx:id="emailField"
               promptText="Email"
               maxWidth="320.0"/>

    <PasswordField fx:id="passwordField"
                   promptText="New Password (leave blank to keep current)"
                   maxWidth="320.0"/>

    <TextField fx:id="streetField"
               promptText="Street"
               maxWidth="320.0"/>

    <TextField fx:id="cityField"
               promptText="City"
               maxWidth="320.0"/>

    <TextField fx:id="stateField"
               promptText="State"
               maxWidth="320.0"/>

    <TextField fx:id="zipCodeField"
               promptText="ZIP Code"
               maxWidth="320.0"/>

    <Label fx:id="messageLabel"
           wrapText="true"
           maxWidth="320.0"/>

    <Button text="Save Changes"
            onAction="#handleSaveChanges"
            maxWidth="320.0"/>

    <Button text="Cancel"
            onAction="#handleCancel"
            maxWidth="320.0"/>

</VBox>